{
  "collections": [
    {
      "name": "users",
      "description": "User profiles mapping to a franchise.",
      "fields": [
        { "name": "uid", "type": "string" },
        { "name": "email", "type": "string" },
        { "name": "franchiseId", "type": "string" },
        { "name": "role", "type": "string" }
      ],
      "rules": [
        "allow read, write: if request.auth != null && request.auth.uid == request.resource.id;"
      ]
    },
    {
      "name": "franchises",
      "description": "Team workspaces for each location.",
      "fields": [
        { "name": "name", "type": "string" },
        { "name": "inviteCode", "type": "string" },
        { "name": "ownerId", "type": "string" }
      ],
      "rules": [
        "allow read: if request.auth != null;",
        "allow create: if request.auth != null;"
      ]
    },
    {
      "name": "entries",
      "description": "Daily sales entries.",
      "fields": [],
      "rules": ["allow read, write, delete: if true;"]
    },
    {
      "name": "settings",
      "description": "Global settings for the franchise.",
      "fields": [],
      "rules": ["allow read, write: if true;"]
    },
    {
      "name": "logs",
      "description": "Audit history logs.",
      "fields": [],
      "rules": ["allow read, write, delete: if request.auth != null;"]
    }
  ]
}
