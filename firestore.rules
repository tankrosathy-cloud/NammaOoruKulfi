rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function getUserFranchiseId() {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid))
        ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('franchiseId', null)
        : null;
    }
    
    function isSuperAdmin() {
      return isAuthenticated() && (
        request.auth.token.email in ['superadmin@gmail.com', 'nammaoorukulfisathy@gmail.com', 'NammaOoruKulfisathy@gmail.com'] ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', '') in ['superadmin', 'super_admin'])
      );
    }

    function isFranchiseMember(franchiseId) {
      return isAuthenticated() && (
        isSuperAdmin() ||
        franchiseId == 'global' ||
        franchiseId == 'NONE' ||
        franchiseId == 'all' ||
        getUserFranchiseId() == franchiseId
      );
    }

    function isOwnerOfUserFranchise() {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
             (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', '') in ['owner', 'manager']) && 
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('franchiseId', '') == resource.data.franchiseId;
    }

    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create, update: if isAuthenticated() && (request.auth.uid == userId || isOwnerOfUserFranchise() || isSuperAdmin());
    }

    match /franchises/{franchiseId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update: if isAuthenticated() && (
        resource.data.get('ownerId', '') == request.auth.uid || 
        resource.data.get('ownerId', '') == '' ||
        !('ownerId' in resource.data) ||
        resource.id == getUserFranchiseId() || 
        isSuperAdmin()
      );
    }

    match /entries/{entryId} {
      allow read, update, delete: if isSuperAdmin() || isFranchiseMember(resource.data.franchiseId);
      allow create: if isSuperAdmin() || isFranchiseMember(request.resource.data.franchiseId);
    }
    
    match /expenses/{expenseId} {
      allow read, update, delete: if isSuperAdmin() || isFranchiseMember(resource.data.franchiseId);
      allow create: if isSuperAdmin() || isFranchiseMember(request.resource.data.franchiseId);
    }

    match /profitWithdrawals/{withdrawalId} {
      allow read, update, delete: if isSuperAdmin() || isFranchiseMember(resource.data.franchiseId);
      allow create: if isSuperAdmin() || isFranchiseMember(request.resource.data.franchiseId);
    }

    match /specialOrders/{orderId} {
      allow read, update, delete: if isSuperAdmin() || isFranchiseMember(resource.data.franchiseId);
      allow create: if isSuperAdmin() || isFranchiseMember(request.resource.data.franchiseId);
    }

    match /daily_denominations/{date} {
      allow read, update, delete: if isAuthenticated();
      allow create: if isAuthenticated();
    }

    match /bills/{billId} {
      allow read: if true;
      allow write, delete: if isAuthenticated();
    }

    match /logs/{logId} {
      allow read, create, delete: if isAuthenticated();
      allow update: if isAuthenticated();
    }

    match /settings/{docId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    match /inventory/{docId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }
  }
}
