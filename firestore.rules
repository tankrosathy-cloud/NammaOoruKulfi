rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function getUserFranchiseId() {
      let userDoc = get(/databases/$(database)/documents/users/$(request.auth.uid));
      return userDoc != null ? userDoc.data.get('franchiseId', null) : null;
    }
    
    function isFranchiseMember(franchiseId) {
      return isAuthenticated() && getUserFranchiseId() == franchiseId;
    }

    function isSuperAdmin() {
      let userDoc = get(/databases/$(database)/documents/users/$(request.auth.uid));
      return userDoc != null && userDoc.data.role == 'superadmin';
    }

    function isOwnerOfUserFranchise() {
      let updaterDoc = get(/databases/$(database)/documents/users/$(request.auth.uid));
      return updaterDoc != null && 
             (updaterDoc.data.role == 'owner' || updaterDoc.data.role == 'manager') && 
             updaterDoc.data.franchiseId == resource.data.franchiseId;
    }

    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.auth.uid == userId;
      allow update: if isAuthenticated() && (request.auth.uid == userId || isOwnerOfUserFranchise() || isSuperAdmin());
    }

    match /franchises/{franchiseId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update: if isAuthenticated() && (resource.data.get('ownerId', '') == request.auth.uid || resource.id == getUserFranchiseId());
    }

    match /entries/{entryId} {
      allow read, update, delete: if isSuperAdmin() || isFranchiseMember(resource.data.franchiseId);
      allow create: if isSuperAdmin() || isFranchiseMember(request.resource.data.franchiseId);
    }
    
    match /expenses/{expenseId} {
      allow read, update, delete: if isSuperAdmin() || isFranchiseMember(resource.data.franchiseId);
      allow create: if isSuperAdmin() || isFranchiseMember(request.resource.data.franchiseId);
    }

    match /profitWithdrawals/{withdrawalId} {
      allow read, update, delete: if isSuperAdmin() || isFranchiseMember(resource.data.franchiseId);
      allow create: if isSuperAdmin() || isFranchiseMember(request.resource.data.franchiseId);
    }

    match /specialOrders/{orderId} {
      allow read, update, delete: if isSuperAdmin() || isFranchiseMember(resource.data.franchiseId);
      allow create: if isSuperAdmin() || isFranchiseMember(request.resource.data.franchiseId);
    }

    match /daily_denominations/{date} {
      allow read, update, delete: if isSuperAdmin() || isFranchiseMember(resource.data.franchiseId);
      allow create: if isSuperAdmin() || isFranchiseMember(request.resource.data.franchiseId);
    }

    match /logs/{logId} {
      allow read, create, delete: if isAuthenticated();
      allow update: if isAuthenticated();
    }

    match /settings/{docId} {
      allow read, update, delete: if isSuperAdmin() || isFranchiseMember(docId) || docId == 'global';
      allow create: if isSuperAdmin() || isFranchiseMember(docId) || docId == 'global';
    }

    match /inventory/{docId} {
      allow read, update, delete: if isSuperAdmin() || isFranchiseMember(docId) || docId == 'global';
      allow create: if isSuperAdmin() || isFranchiseMember(docId) || docId == 'global';
    }
  }
}
